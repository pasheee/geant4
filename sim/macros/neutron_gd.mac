/control/verbose 0
/run/verbose 0
/tracking/verbose 0

/det/dopant Gd
/run/initialize

/gen/mode mono
/gen/particle neutron
/gen/monoEnergy 10 keV
/gen/isotropic true
/gen/randomizePos true

/analysis/neutronLifetimeFile neutron_lifetime_Gd.txt

# Prompt neutron-capture gamma cascade (per-gamma spectrum + per-capture summary,
# tagged by residual nucleus so Gd captures can be isolated from H captures).
/analysis/writeCaptureGammas true
/analysis/captureGammaFile capture_gammas_Gd.txt
/analysis/captureSummaryFile capture_summary_Gd.txt

/run/beamOn 100000
