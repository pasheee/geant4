# Mono-energetic positron template for uniform Te scan.
# Placeholders __ENERGY__ (MeV) and __EVENTS__ are substituted by run_uniform_te_scan.sh.

/control/verbose 0
/run/verbose 0
/tracking/verbose 0

/run/initialize

/run/printProgress 5000

/analysis/writeCherenkovSpectrum false

/gen/mode mono
/gen/particle e+
/gen/monoEnergy __ENERGY__ MeV
/gen/isotropic true
/gen/randomizePos true

/run/beamOn __EVENTS__
